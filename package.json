{
    "name": "@diia-inhouse/diia-logger",
    "version": "4.4.23",
    "type": "module",
    "description": "Logger package",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": "https://github.com/diia-open-source/be-diia-logger",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "rimraf dist/ && tsdown",
        "prepare": "npm run build",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "format": "oxfmt \"src/**/*.ts\"",
        "semantic-release": "semantic-release",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "dependencies": {
        "@opentelemetry/api": "1.9.1",
        "lodash": "4.18.1",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.0.1",
        "@diia-inhouse/eslint-plugin": "1.9.9",
        "@diia-inhouse/oxc-config": "2.1.1",
        "@diia-inhouse/types": "14.2.1",
        "@diia-inhouse/utils": "6.0.57",
        "@types/lodash": "4.17.24",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "oxlint-tsgolint": "0.22.1",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "type-fest": "5.6.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.5"
    },
    "peerDependencies": {
        "@diia-inhouse/types": ">=13.1.0",
        "@diia-inhouse/utils": ">=6.0.0"
    },
    "peerDependenciesMeta": {
        "@diia-inhouse/utils": {
            "optional": true
        }
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
