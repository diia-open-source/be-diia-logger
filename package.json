{
    "name": "@diia-inhouse/diia-logger",
    "version": "3.17.2",
    "description": "Logger package",
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "repository": "https://github.com/diia-open-source/be-diia-logger.git",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "rimraf dist/ && tsc",
        "prepare": "npm run build",
        "lint": "eslint . && prettier --check .",
        "lint-fix": "eslint --fix . && prettier --write .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "format": "prettier --write \"src/**/*.ts\"",
        "semantic-release": "semantic-release",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "dependencies": {
        "bson": "7.2.0",
        "lodash": "4.18.1",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "6.1.1",
        "@diia-inhouse/eslint-config": "8.8.0",
        "@diia-inhouse/eslint-plugin": "1.9.5",
        "@diia-inhouse/types": "11.6.0",
        "@diia-inhouse/utils": "5.3.4",
        "@types/lodash": "4.17.24",
        "@vitest/coverage-v8": "4.0.18",
        "@vitest/ui": "4.0.18",
        "eslint": "9.33.0",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "rimraf": "6.1.3",
        "semantic-release": "24.2.7",
        "type-fest": "4.33.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.0.18"
    },
    "peerDependencies": {
        "@diia-inhouse/types": ">=6.76.0",
        "@diia-inhouse/utils": ">=4.31.0"
    },
    "peerDependenciesMeta": {
        "@diia-inhouse/utils": {
            "optional": true
        }
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "prettier": "@diia-inhouse/eslint-config/prettier",
    "madge": {
        "tsConfig": "./tsconfig.json"
    },
    "jest": {
        "preset": "@diia-inhouse/configs/dist/jest"
    }
}
